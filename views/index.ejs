<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TSA Bot - Web Yönetim Paneli</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #1e1f22;
            color: #f2f3f5;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 900px;
            margin: 0 auto;
            background-color: #2b2d31;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }
        .user-profile {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background-color: #232428;
            padding: 12px 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }
        .user-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
        }
        .logout-btn {
            background-color: #da373c;
            color: white;
            text-decoration: none;
            padding: 8px 15px;
            border-radius: 5px;
            font-weight: bold;
            font-size: 14px;
        }
        h1 {
            color: #5865f2;
            text-align: center;
            margin-bottom: 30px;
        }
        .card {
            background-color: #313338;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            border: 1px solid #3f4147;
        }
        label {
            display: block;
            font-weight: bold;
            margin-bottom: 8px;
            color: #b5bac1;
        }
        select, input[type="text"] {
            width: 100%;
            padding: 10px;
            background-color: #1e1f22;
            border: 1px solid #4e5058;
            color: #f2f3f5;
            border-radius: 6px;
            box-sizing: border-box;
            font-size: 16px;
        }
        .btn {
            background-color: #248046;
            color: white;
            border: none;
            padding: 12px 20px;
            font-size: 16px;
            border-radius: 6px;
            cursor: pointer;
            width: 100%;
            font-weight: bold;
            margin-top: 15px;
        }
        .btn:hover { background-color: #1a6535; }
        .footer {
            text-align: center;
            margin-top: 30px;
            color: #949ba4;
            font-size: 14px;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="user-profile">
        <div class="user-info">
            <img class="user-avatar" src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="Profil">
            <span>Hoş geldin yetkili, <strong><%= user.username %></strong></span>
        </div>
        <a href="/cikis" class="logout-btn">🔒 Güvenli Çıkış</a>
    </div>

    <h1>🛡 TSA Moderasyon & Guard Web Panel</h1>

    <form action="/ayarla" method="POST">
        <div class="card">
            <label for="guildId">⚙️ Yönetilecek Sunucu ID:</label>
            <input type="text" id="guildId" name="guildId" value="<%= varsayilanGuild %>" placeholder="Sunucunuzun ID'sini girin" required>
        </div>

        <div class="card">
            <label for="guardDurum">🚨 Anti-Raid / Guard Koruması:</label>
            <select id="guardDurum" name="guardDurum">
                <option value="true" <%= guardAktif ? 'selected' : '' %>>🛡️ %100 Otomatik Guard Aktif</option>
                <option value="false" <%= !guardAktif ? 'selected' : '' %>>🔓 Korumayı Devre Dışı Bırak</option>
            </select>
        </div>

        <div class="card">
            <label for="logKanal">📝 Gelişmiş Rapor (Log) Kanal ID:</label>
            <input type="text" id="logKanal" name="logKanal" value="<%= logKanalId %>" placeholder="Örn: 1505143174191000000">
        </div>

        <button type="submit" class="btn">💾 Ayarları Veritabanına Kaydet ve Uygula</button>
    </form>

    <div class="footer">
        TSA Güvenlik Teknolojileri © 2026 - Tüm Hakları Saklıdır.
    </div>
</div>

</body>
</html>
